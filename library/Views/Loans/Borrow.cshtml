@model BorrowForm

@{
    ViewData["Title"] = "Borrow a Book";
}

<div class="container py-4">
    <div class="mb-4">
        <p class="text-uppercase text-muted small mb-1">Library Management</p>
        <h1 class="fw-bold mb-1">📖 Borrow a Book</h1>
        <p class="text-muted">Fill in the details below to record a new book loan.</p>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="max-width: 42rem;">
        <div class="p-4 text-white"
             style="background: linear-gradient(135deg, #212529, #495057);">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-3" style="background: #dc3545;">
                    <span class="fs-3">📚</span>
                </div>
                <div>
                    <h4 class="fw-bold mb-1">Loan Information</h4>
                    <p class="text-white-50 mb-0">Enter the borrowing details below.</p>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <form asp-action="Borrow" method="post">
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger rounded-3 mb-3"></div>

                <div class="mb-4">
                    <label asp-for="MemberId" class="form-label fw-semibold">
                        Member
                    </label>

                    <select asp-for="MemberId"
                            asp-items="ViewBag.Members"
                            class="form-select form-select-lg rounded-3">
                        <option value="">(choose a member)</option>
                    </select>

                    <span asp-validation-for="MemberId" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="BookId" class="form-label fw-semibold">
                        Book
                    </label>

                    <select asp-for="BookId"
                            asp-items="ViewBag.Books"
                            class="form-select form-select-lg rounded-3">
                        <option value="">(choose a book)</option>
                    </select>

                    <span asp-validation-for="BookId" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="DaysAllowed" class="form-label fw-semibold">
                        Days Allowed
                    </label>

                    <input asp-for="DaysAllowed"
                           class="form-control form-control-lg rounded-3" />

                    <div class="form-text">
                        Enter the number of days the member can borrow the book.
                    </div>

                    <span asp-validation-for="DaysAllowed" class="text-danger small"></span>
                </div>

                <hr class="my-4" />

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit"
                            class="btn btn-danger px-4 py-2 rounded-3">
                        ✓ Confirm Borrow
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary px-4 py-2 rounded-3">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

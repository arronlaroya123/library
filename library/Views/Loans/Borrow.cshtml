@model BorrowForm

@{
    ViewData["Title"] = "Borrow a book";
}

<div class="container py-4">
    <div class="mb-4">
        <p class="text-uppercase text-muted small mb-1">Library Management</p>
        <h1 class="fw-bold mb-1">📖 Borrow a Book</h1>
        <p class="text-muted">Fill in the details below to record a new book loan.</p>
    </div>

    <div class="card shadow-sm border-0" style="max-width: 42rem;">
        <div class="card-header bg-primary text-white py-3">
            <h5 class="mb-0">Loan Information</h5>
        </div>

        <div class="card-body p-4">
            <form asp-action="Borrow" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="MemberId" class="form-label fw-semibold">
                        Member
                    </label>
                    <select asp-for="MemberId" asp-items="ViewBag.Members" class="form-select">
                        <option value="">(choose a member)</option>
                    </select>
                    <span asp-validation-for="MemberId" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="BookId" class="form-label fw-semibold">
                        Book
                    </label>
                    <select asp-for="BookId" asp-items="ViewBag.Books" class="form-select">
                        <option value="">(choose a book)</option>
                    </select>
                    <span asp-validation-for="BookId" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="DaysAllowed" class="form-label fw-semibold">
                        Days Allowed
                    </label>
                    <input asp-for="DaysAllowed" class="form-control" />
                    <div class="form-text">Enter the number of days the member can borrow the book.</div>
                    <span asp-validation-for="DaysAllowed" class="text-danger small"></span>
                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        ✓ Confirm Borrow
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

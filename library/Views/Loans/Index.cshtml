@model List<LoanView>

@{
    ViewData["Title"] = "Loans";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <p class="text-uppercase text-muted small mb-1">
                Library Management
            </p>
            <h1 class="fw-bold mb-1">Loan Records</h1>
            <p class="text-muted mb-0">
                Monitor borrowed books and their return status.
            </p>
        </div>

        <a asp-action="Borrow" class="btn btn-primary px-4">
            + Borrow a Book
        </a>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted mb-1">Total Loan Records</p>
                    <h2 class="fw-bold mb-0">@Model.Count</h2>
                </div>
                <div class="bg-light rounded-3 p-3">
                    <span class="fs-2">📚</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="fw-semibold mb-0">All Loans</h5>
            <small class="text-muted">Newest records appear first</small>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="px-4 py-3">Member</th>
                        <th class="py-3">Book</th>
                        <th class="py-3">Loaned</th>
                        <th class="py-3">Due Date</th>
                        <th class="py-3">Status</th>
                        <th class="text-end pe-4">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var loan in Model)
                    {
                        <tr>
                            <td class="px-4 fw-semibold">
                                @loan.MemberName
                            </td>

                            <td>@loan.BookTitle</td>

                            <td>
                                @loan.LoanedOn.ToString("yyyy-MM-dd")
                            </td>

                            <td>
                                @loan.LoanedOn.AddDays(loan.DaysAllowed).ToString("yyyy-MM-dd")
                            </td>

                            <td>
                                <span class="badge rounded-pill @(loan.Status == "Overdue" ? "text-bg-danger" : loan.Status == "Out" ? "text-bg-warning" : "text-bg-success")">
                                    @loan.Status
                                </span>
                            </td>

                            <td class="text-end pe-4">
                                @if (loan.ReturnedOn == null)
                                {
                                    <form asp-action="Return"
                                          asp-route-id="@loan.LoanId"
                                          method="post"
                                          class="d-inline">
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-success">
                                            Return
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">Completed</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <h5>No loan records found</h5>
                <p class="mb-0">Borrow a book to create a new record.</p>
            </div>
        }
    </div>

</div>

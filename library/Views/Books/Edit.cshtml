@model Book

@{
    ViewData["Title"] = "Edit a Book";
}

<div class="container py-4">

    <!-- Header -->
    <div class="mb-4">
        <span class="text-danger fw-bold text-uppercase small"
              style="letter-spacing: 3px;">
            Library Management
        </span>

        <h1 class="fw-bold mt-2 mb-1">Edit a Book</h1>

        <p class="text-muted mb-0">
            Update the information of your selected book.
        </p>
    </div>

    <!-- Form Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden"
         style="max-width: 650px;">

        <!-- Card Header -->
        <div class="card-header border-0 text-white p-4"
             style="background: linear-gradient(135deg, #181818, #383838);">

            <div class="d-flex align-items-center gap-3">

                <div class="rounded-3 d-flex align-items-center justify-content-center"
                     style="width: 50px; height: 50px; background: #dc3545;">
                    <span style="font-size: 25px;">📚</span>
                </div>

                <div>
                    <h5 class="fw-bold mb-1">Update Book Information</h5>
                    <small class="text-white-50">
                        Edit the book details below.
                    </small>
                </div>

            </div>
        </div>

        <!-- Card Body -->
        <div class="card-body p-4">

            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="BookId" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger rounded-3">
                </div>

                <!-- Book Title -->
                <div class="mb-4">

                    <label asp-for="Title"
                           class="form-label fw-semibold">
                        Book Title
                    </label>

                    <input asp-for="Title"
                           class="form-control form-control-lg rounded-3"
                           placeholder="Enter book title" />

                    <span asp-validation-for="Title"
                          class="text-danger small">
                    </span>

                </div>

                <!-- Category -->
                <div class="mb-4">

                    <label asp-for="Category"
                           class="form-label fw-semibold">
                        Category
                    </label>

                    <select asp-for="Category"
                            class="form-select form-select-lg rounded-3">

                        <option value="">-- Choose category --</option>
                        <option>Fiction</option>
                        <option>Classic</option>
                        <option>Textbook</option>
                        <option>Reference</option>
                        <option>Poetry</option>
                        <option>History</option>
                        <option>Science</option>

                    </select>

                    <span asp-validation-for="Category"
                          class="text-danger small">
                    </span>

                </div>

                <!-- Price -->
                <div class="mb-4">

                    <label asp-for="Price"
                           class="form-label fw-semibold">
                        Price
                    </label>

                    <div class="input-group input-group-lg">

                        <span class="input-group-text bg-light rounded-start-3">
                            ₱
                        </span>

                        <input asp-for="Price"
                               class="form-control rounded-end-3"
                               placeholder="Enter book price" />

                    </div>

                    <span asp-validation-for="Price"
                          class="text-danger small">
                    </span>

                </div>

                <hr class="my-4" />

                <!-- Buttons -->
                <div class="d-flex gap-2 flex-wrap">

                    <button type="submit"
                            class="btn btn-danger px-4 py-2 rounded-3">
                        ✓ Save Changes
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-dark px-4 py-2 rounded-3">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

    <p class="text-muted small mt-3">
        Review your changes before saving the updated book information.
    </p>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

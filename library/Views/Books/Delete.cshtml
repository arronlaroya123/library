@model Book

@{
    ViewData["Title"] = "Delete a Book";
}

<div class="container py-4">
    <div class="mb-4">
        <p class="text-uppercase text-muted small mb-1">Library Management</p>
        <h1 class="fw-bold mb-1">🗑️ Delete a Book</h1>
        <p class="text-muted">Review the book information before deleting.</p>
    </div>

    <div class="card border-danger shadow-sm" style="max-width: 42rem;">
        <div class="card-header bg-danger text-white py-3">
            <h5 class="mb-0">⚠️ Delete Confirmation</h5>
        </div>

        <div class="card-body p-4">
            <div class="alert alert-danger">
                <strong>Warning!</strong> Are you sure you want to delete this book?
                This action cannot be undone.
            </div>

            <h5 class="fw-bold mb-3">Book Information</h5>

            <dl class="row mb-4">
                <dt class="col-sm-4 text-muted">Title</dt>
                <dd class="col-sm-8 fw-semibold">@Model.Title</dd>

                <dt class="col-sm-4 text-muted">Category</dt>
                <dd class="col-sm-8">@(Model.Category ?? "—")</dd>

                <dt class="col-sm-4 text-muted">Price</dt>
                <dd class="col-sm-8">@(Model.Price?.ToString("0.00") ?? "—")</dd>
            </dl>

            <hr />

            <form asp-action="DeleteConfirmed" method="post">
                <input type="hidden" asp-for="BookId" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger px-4">
                        🗑️ Confirm Delete
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

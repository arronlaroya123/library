@model List<Book>

@{
    ViewData["Title"] = "Books";
}

<div class="container-fluid py-4 px-lg-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <span class="text-danger fw-bold text-uppercase small"
                  style="letter-spacing: 3px;">
                Library Management
            </span>

            <h1 class="fw-bold mt-2 mb-1">Book Catalogue</h1>

            <p class="text-muted mb-0">
                Browse and manage your library collection.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-danger px-4 py-2 rounded-3 shadow-sm">
            + Add a Book
        </a>
    </div>

    <!-- Total Books -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 text-white"
                 style="background: linear-gradient(135deg, #181818, #3a3a3a);">

                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-white-50 mb-2">
                                TOTAL BOOKS
                            </p>

                            <h2 class="fw-bold mb-0 text-white"
                                style="color: #ffffff !important;">
                                @Model.Count
                            </h2>

                            <small class="text-white-50">
                                Books in collection
                            </small>
                        </div>

                        <div class="rounded-3 p-3 d-flex align-items-center justify-content-center"
                             style="background: #dc3545;">
                            <span class="fs-2">📚</span>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Books Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="card-header bg-white border-0 px-4 py-3">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                <div>
                    <h5 class="fw-bold mb-1">
                        Book Collection
                    </h5>

                    <small class="text-muted">
                        Manage all registered books
                    </small>
                </div>

                <span class="badge bg-danger rounded-pill px-3 py-2">
                    @Model.Count Books
                </span>

            </div>
        </div>

        @if (Model.Count > 0)
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle text-center mb-0">

                    <thead style="background-color: #252525; color: white;">
                        <tr>
                            <th class="py-3">#</th>
                            <th class="py-3 text-start">Book Title</th>
                            <th class="py-3">Category</th>
                            <th class="py-3">Price</th>
                            <th class="py-3">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            var number = 1;
                        }

                        @foreach (var book in Model)
                        {
                            <tr>

                                <td class="fw-semibold text-muted">
                                    @number
                                </td>

                                <td class="text-start">

                                    <div class="d-flex align-items-center gap-3">

                                        <div class="rounded-3 d-flex align-items-center justify-content-center"
                                             style="width: 42px;
                                            height: 42px;
                                            background: #eeeeee;
                                            flex-shrink: 0;">
                                            <span style="font-size: 20px;">
                                                📖
                                            </span>
                                        </div>

                                        <span class="fw-semibold">
                                            @book.Title
                                        </span>

                                    </div>

                                </td>

                                <td>
                                    <span class="badge rounded-pill px-3 py-2"
                                          style="background: #eeeeee; color: #333;">
                                        @(book.Category ?? "Uncategorized")
                                    </span>
                                </td>

                                <td class="fw-semibold">
                                    @(book.Price?.ToString("0.00") ?? "—")
                                </td>

                                <td>

                                    <div class="d-flex justify-content-center gap-2 flex-wrap">

                                        <a asp-action="Edit"
                                           asp-route-id="@book.BookId"
                                           class="btn btn-sm btn-outline-dark px-3 rounded-2">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@book.BookId"
                                           class="btn btn-sm btn-outline-danger px-3 rounded-2">
                                            Delete
                                        </a>

                                    </div>

                                </td>

                            </tr>

                            number++;
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <div style="font-size: 55px;">📚</div>

                <h5 class="fw-bold mt-3">
                    No Books Found
                </h5>

                <p class="text-muted">
                    Your library collection is currently empty.
                </p>

                <a asp-action="Create"
                   class="btn btn-danger px-4 rounded-3">
                    + Add Your First Book
                </a>

            </div>
        }

        <!-- Footer -->
        <div class="card-footer bg-white border-0 px-4 py-3">

            <small class="text-muted">
                Showing @Model.Count books in your library.
            </small>

        </div>

    </div>

</div>

@model MemberDetails

@{
    ViewData["Title"] = Model.Member.FullName;
}

<div class="container py-4">
    <div class="mb-4">
        <p class="text-uppercase text-muted small mb-1">Library Management</p>
        <h1 class="fw-bold mb-1">Member Profile</h1>
        <p class="text-muted">Member information and borrowing history</p>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                     style="width: 55px; height: 55px; font-size: 1.4rem;">
                    👤
                </div>
                <div>
                    <h3 class="fw-bold mb-1">@Model.Member.FullName</h3>
                    <span class="badge text-bg-primary">@Model.Member.MemberType</span>
                </div>
            </div>

            <hr />

            <p class="mb-1 text-muted small">Email Address</p>
            <p class="mb-0 fw-semibold">@(Model.Member.Email ?? "No email provided")</p>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="h4 fw-bold mb-1">📚 Loan History</h2>
            <p class="text-muted mb-0">@Model.Loans.Count loan records</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (Model.Loans.Count == 0)
            {
                <div class="text-center py-5">
                    <h5>No Loan Records</h5>
                    <p class="text-muted mb-0">This member has never borrowed a book.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="ps-3">Book</th>
                                <th>Loaned</th>
                                <th>Returned</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var loan in Model.Loans)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">@loan.BookTitle</td>
                                    <td>@loan.LoanedOn.ToString("yyyy-MM-dd")</td>
                                    <td>@(loan.ReturnedOn?.ToString("yyyy-MM-dd") ?? "—")</td>
                                    <td>
                                        <span class="badge rounded-pill @(loan.Status == "Overdue" ? "text-bg-danger" : loan.Status == "Out" ? "text-bg-warning" : "text-bg-success")">
                                            @loan.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary mt-4">
        ← Back to Members
    </a>
</div>

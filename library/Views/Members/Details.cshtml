@model MemberDetails

@{
    ViewData["Title"] = Model.Member.FullName;
}

<div class="container py-4">
    <div class="mb-4">
        <p class="text-uppercase text-muted small mb-1">Library Management</p>
        <h1 class="fw-bold mb-1">Member Profile</h1>
        <p class="text-muted">Member information and borrowing history.</p>
    </div>

    <!-- Member Information -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-dark text-white py-3">
            <h5 class="mb-0 fw-semibold">Member Information</h5>
        </div>

        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white"
                     style="width: 60px; height: 60px; font-size: 1.5rem; background-color: #dc3545;">
                    👤
                </div>

                <div>
                    <h3 class="fw-bold mb-1">@Model.Member.FullName</h3>
                    <span class="badge bg-secondary rounded-pill px-3">
                        @Model.Member.MemberType
                    </span>
                </div>
            </div>

            <hr />

            <p class="text-muted small mb-1">Email Address</p>
            <p class="fw-semibold mb-0">
                @(Model.Member.Email ?? "No email provided")
            </p>
        </div>
    </div>

    <!-- Loan History -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="h4 fw-bold mb-1">📚 Loan History</h2>
            <p class="text-muted mb-0">
                @Model.Loans.Count loan records
            </p>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-dark text-white py-3">
            <h5 class="fw-semibold mb-0">Borrowing Records</h5>
        </div>

        <div class="card-body p-0">
            @if (Model.Loans.Count == 0)
            {
                <div class="text-center py-5">
                    <div class="fs-1 mb-3">📚</div>
                    <h5 class="fw-bold">No Loan Records</h5>
                    <p class="text-muted mb-0">
                        This member has never borrowed a book.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4 py-3">Book</th>
                                <th class="py-3">Loaned</th>
                                <th class="py-3">Returned</th>
                                <th class="py-3">Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var loan in Model.Loans)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">
                                        @loan.BookTitle
                                    </td>

                                    <td class="text-nowrap">
                                        @loan.LoanedOn.ToString("yyyy-MM-dd")
                                    </td>

                                    <td class="text-nowrap">
                                        @(loan.ReturnedOn?.ToString("yyyy-MM-dd") ?? "—")
                                    </td>

                                    <td>
                                        @if (loan.Status == "Overdue")
                                        {
                                            <span class="badge rounded-pill text-bg-danger">
                                                Overdue
                                            </span>
                                        }
                                        else if (loan.Status == "Out")
                                        {
                                            <span class="badge rounded-pill text-bg-warning">
                                                Out
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill text-bg-success">
                                                Returned
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="card-footer bg-white text-muted small py-3">
            Total loan records: @Model.Loans.Count
        </div>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary rounded-3 px-4 mt-4">
        ← Back to Members
    </a>
</div>

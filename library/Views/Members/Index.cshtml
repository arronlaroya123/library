@model List<library.Models.Member>

@{
    ViewData["Title"] = "Members";
}


<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Members</h1>
    <a asp-controller="Members" asp-action="Create"
       class="btn btn-primary">Add a member</a>
</div>
</div>

<p>@Model.Count members in the catalogue.</p>

<table class="table">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Member Type</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
    @foreach (var member in Model)
    {
        <tr>
            <td>@member.FullName</td>
            <td>@(member.Email ?? "—")</td>
            <td>@member.MemberType</td>
            <td>
    <a asp-action="Edit"
       asp-route-id="@member.MemberId"
       class="btn btn-sm btn-primary">Edit</a>
</td>
        </tr>
    }
    </tbody>
</table>
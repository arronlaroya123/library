@model List<library.Models.Member>

@{
    ViewData["Title"] = "Members";
}

<div class="container-fluid py-4 px-lg-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <span class="text-danger fw-bold text-uppercase small"
                  style="letter-spacing: 3px;">
                Library Management
            </span>

            <h1 class="fw-bold mt-2 mb-1">Member Directory</h1>

            <p class="text-muted mb-0">
                View and manage your library members.
            </p>
        </div>

        <a asp-controller="Members"
           asp-action="Create"
           class="btn btn-danger px-4 py-2 rounded-3 shadow-sm">
            + Add a Member
        </a>
    </div>

    <!-- Total Members -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 text-white"
                 style="background: linear-gradient(135deg, #181818, #3a3a3a);">

                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-white-50 mb-2">
                                TOTAL MEMBERS
                            </p>

                            <h2 class="fw-bold mb-0 text-white"
                                style="color: #ffffff !important;">
                                @Model.Count
                            </h2>

                            <small class="text-white-50">
                                Registered library members
                            </small>
                        </div>

                        <div class="rounded-3 p-3 d-flex align-items-center justify-content-center"
                             style="background: #dc3545;">
                            <span class="fs-2">👥</span>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Members Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="card-header bg-white border-0 px-4 py-3">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                <div>
                    <h5 class="fw-bold mb-1">
                        Member Collection
                    </h5>

                    <small class="text-muted">
                        Manage all registered library members
                    </small>
                </div>

                <span class="badge bg-danger rounded-pill px-3 py-2">
                    @Model.Count Members
                </span>

            </div>
        </div>

        @if (Model.Count > 0)
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle text-center mb-0">

                    <thead style="background-color: #252525; color: white;">
                        <tr>
                            <th class="py-3">#</th>
                            <th class="py-3 text-start">Full Name</th>
                            <th class="py-3">Email</th>
                            <th class="py-3">Member Type</th>
                            <th class="py-3">Books Out</th>
                            <th class="py-3">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            var number = 1;
                        }

                        @foreach (var member in Model)
                        {
                            <tr>

                                <td class="fw-semibold text-muted">
                                    @number
                                </td>

                                <!-- Full Name -->
                                <td class="text-start">

                                    <div class="d-flex align-items-center gap-3">

                                        <div class="rounded-3 d-flex align-items-center justify-content-center"
                                             style="width: 42px;
                                            height: 42px;
                                            background: #eeeeee;
                                            flex-shrink: 0;">
                                            <span style="font-size: 20px;">👤</span>
                                        </div>

                                        <span class="fw-semibold">
                                            @member.FullName
                                        </span>

                                    </div>

                                </td>

                                <!-- Email -->
                                <td class="text-muted">
                                    @(member.Email ?? "—")
                                </td>

                                <!-- Member Type -->
                                <td>
                                    <span class="badge rounded-pill px-3 py-2"
                                          style="background: #eeeeee; color: #333;">
                                        @member.MemberType
                                    </span>
                                </td>

                                <!-- Books Out -->
                                <td>
                                    @if (member.OpenLoans > 0)
                                    {
                                        <span class="badge bg-danger rounded-pill px-3 py-2">
                                            @member.OpenLoans
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill px-3 py-2"
                                              style="background: #eeeeee; color: #333;">
                                            0
                                        </span>
                                    }
                                </td>

                                <!-- Actions -->
                                <td>

                                    <div class="d-flex justify-content-center gap-2 flex-wrap">

                                        <a asp-action="Details"
                                           asp-route-id="@member.MemberId"
                                           class="btn btn-sm btn-outline-dark px-3 rounded-2">
                                            Loans
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@member.MemberId"
                                           class="btn btn-sm btn-outline-dark px-3 rounded-2">
                                            Edit
                                        </a>

                                        <form asp-action="Delete"
                                              asp-route-id="@member.MemberId"
                                              method="post"
                                              style="display:inline"
                                              onsubmit="return confirm('Are you sure you want to delete this member?');">

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger px-3 rounded-2">
                                                Delete
                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>

                            number++;
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <div style="font-size: 55px;">👥</div>

                <h5 class="fw-bold mt-3">
                    No Members Found
                </h5>

                <p class="text-muted">
                    Your library currently has no registered members.
                </p>

                <a asp-controller="Members"
                   asp-action="Create"
                   class="btn btn-danger px-4 rounded-3">
                    + Add Your First Member
                </a>

            </div>
        }

        <!-- Footer -->
        <div class="card-footer bg-white border-0 px-4 py-3">
            <small class="text-muted">
                Showing @Model.Count members in your library.
            </small>
        </div>

    </div>

</div>

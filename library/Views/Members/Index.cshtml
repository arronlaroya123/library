
@model List<library.Models.Member>

@{
    ViewData["Title"] = "Members";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <p class="text-uppercase text-muted small mb-1">
                Library Management
            </p>
            <h1 class="fw-bold mb-1">Member Directory</h1>
            <p class="text-muted mb-0">
                View and manage library members.
            </p>
        </div>

        <a asp-controller="Members"
           asp-action="Create"
           class="btn btn-primary px-4">
            + Add a Member
        </a>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <p class="text-muted mb-1">Total Members</p>
            <h2 class="fw-bold mb-0">@Model.Count</h2>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-semibold">All Members</h5>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="px-4 py-3">Full Name</th>
                        <th class="py-3">Email</th>
                        <th class="py-3">Member Type</th>
                        <th class="py-3 text-end pe-4">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var member in Model)
                    {
                        <tr>
                            <td class="px-4 fw-semibold">
                                @member.FullName
                            </td>
                            <td>@(member.Email ?? "—")</td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @member.MemberType
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit"
                                   asp-route-id="@member.MemberId"
                                   class="btn btn-sm btn-outline-primary me-1">
                                    Edit
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@member.MemberId"
                                      method="post"
                                      style="display:inline"
                                      onsubmit="return confirm('Are you sure you want to delete this member?');">
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <h5>No members found</h5>
                <p class="mb-0">Add a member to get started.</p>
            </div>
        }
    </div>
</div>
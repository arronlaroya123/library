@model library.Models.Member

@{
    ViewData["Title"] = "Add a Member";
}

<div class="container py-4">
    <div class="mb-4">
        <p class="text-uppercase text-muted small mb-1">Library Management</p>
        <h1 class="fw-bold mb-1">👤 Add a Member</h1>
        <p class="text-muted">Enter the member's information below.</p>
    </div>

    <div class="card border-0 shadow-sm" style="max-width: 42rem;">
        <div class="card-header bg-primary text-white py-3">
            <h5 class="mb-0">Member Information</h5>
        </div>

        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-4">
                    <label asp-for="FullName" class="form-label fw-semibold">Full Name</label>
                    <input asp-for="FullName" class="form-control" placeholder="Enter full name" required />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                    <input asp-for="Email" class="form-control" type="text" placeholder="Enter email address" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="MemberType" class="form-label fw-semibold">Member Type</label>
                    <select asp-for="MemberType" class="form-select" required>
                        <option value="">(choose member type)</option>
                        <option value="Regular">Regular</option>
                        <option value="Student">Student</option>
                        <option value="Faculty">Faculty</option>
                    </select>
                    <span asp-validation-for="MemberType" class="text-danger small"></span>
                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        + Add Member
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model Member

@{
    ViewData["Title"] = "Cannot Delete Member";
}

<div class="container py-4">
    <div class="mb-4">
        <p class="text-uppercase text-muted small mb-1">Library Management</p>
        <h1 class="fw-bold mb-1">⚠️ Delete Member</h1>
        <p class="text-muted">Review the member deletion warning below.</p>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden"
         style="max-width: 42rem;">

        <div class="p-4 text-white"
             style="background: linear-gradient(135deg, #212529, #495057);">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-3" style="background: #dc3545;">
                    <span class="fs-3">⚠️</span>
                </div>
                <div>
                    <h4 class="fw-bold mb-1">Unable to Delete Member</h4>
                    <p class="text-white-50 mb-0">
                        This member cannot currently be deleted.
                    </p>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="alert alert-danger rounded-3">
                <strong>Deletion Warning</strong>
                <p class="mb-0 mt-1">@ViewBag.Error</p>
            </div>

            <h5 class="fw-bold mb-3">Member Information</h5>

            <div class="bg-light rounded-3 p-3 mb-4">
                <p class="text-muted small mb-1">Full Name</p>
                <h5 class="fw-bold mb-3">@Model.FullName</h5>

                <p class="text-muted small mb-1">Email Address</p>
                <p class="fw-semibold mb-3">
                    @(Model.Email ?? "No email provided")
                </p>

                <p class="text-muted small mb-1">Member Type</p>
                <span class="badge bg-secondary rounded-pill">
                    @Model.MemberType
                </span>
            </div>

            <p class="text-muted">
                This member has existing loan records. The member cannot be
                deleted while these records are connected.
            </p>

            <hr class="my-4" />

            <a asp-action="Index"
               class="btn btn-outline-secondary rounded-3 px-4 py-2">
                ← Back to Members
            </a>
        </div>
    </div>
</div>

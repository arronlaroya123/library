@model Member

@{
    ViewData["Title"] = "Cannot Delete Member";
}

<div class="container py-4">
    <div class="card border-danger shadow-sm" style="max-width: 40rem;">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">⚠ Delete Warning</h4>
        </div>

        <div class="card-body p-4">
            <h5 class="fw-bold">Unable to Delete Member</h5>

            <div class="alert alert-danger mt-3">
                @ViewBag.Error
            </div>

            <p class="mb-1 text-muted">Member:</p>
            <h5>@Model.FullName</h5>
            <p class="text-muted">@Model.Email</p>

            <p class="mt-3">
                This member has existing loan records. The member cannot be deleted while these records are connected.
            </p>

            <a asp-action="Index" class="btn btn-outline-secondary mt-2">
                ← Back to Members
            </a>
        </div>
    </div>
</div>

@model library.Models.Member

@{
    ViewData["Title"] = "Edit a Member";
}

<div class="container py-4">
    <div class="mb-4">
        <p class="text-uppercase text-muted small mb-1">Library Management</p>
        <h1 class="fw-bold mb-1">✏️ Edit a Member</h1>
        <p class="text-muted">Update the member's information below.</p>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="max-width: 42rem;">
        <div class="p-4 text-white" style="background: linear-gradient(135deg, #212529, #495057);">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-3" style="background: #dc3545;">
                    <span class="fs-3">✏️</span>
                </div>
                <div>
                    <h4 class="fw-bold mb-1">Update Member Information</h4>
                    <p class="mb-0 text-white-50">Edit the details of this library member.</p>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <form asp-action="Edit" asp-route-id="@Model.MemberId" method="post">
                <input type="hidden" asp-for="MemberId" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>

                <div class="mb-4">
                    <label asp-for="FullName" class="form-label fw-semibold">Full Name</label>
                    <input asp-for="FullName" class="form-control form-control-lg rounded-3" required />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                    <small class="text-muted">Format: Lastname, Firstname</small>
                </div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                    <input asp-for="Email" class="form-control form-control-lg rounded-3" type="text" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="MemberType" class="form-label fw-semibold">Member Type</label>
                    <select asp-for="MemberType" class="form-select form-select-lg rounded-3" required>
                        <option value="">(choose member type)</option>
                        <option value="Regular">Regular</option>
                        <option value="Student">Student</option>
                        <option value="Faculty">Faculty</option>
                    </select>
                    <span asp-validation-for="MemberType" class="text-danger small"></span>
                </div>

                <hr class="my-4" />

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-danger px-4 py-2 rounded-3">
                        ✓ Save Changes
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-3">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}



@model library.Models.Member

@{
    ViewData["Title"] = "Edit a Member";
}

<h1>Edit a Member</h1>

<form asp-action="Edit" asp-route-id="@Model.MemberId" method="post">
    <input type="hidden" asp-for="MemberId" />

    <div class="mb-3">
        <label asp-for="FullName" class="form-label">Full Name</label>
        <input asp-for="FullName" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" type="text" />
    </div>

    <div class="mb-3">
        <label asp-for="MemberType" class="form-label">Member Type</label>
        <select asp-for="MemberType" class="form-select" required>
            <option value="">(none)</option>
            <option value="Regular">Regular</option>
            <option value="Student">Student</option>
            <option value="Faculty">Faculty</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>